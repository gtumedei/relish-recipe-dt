generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma/client"
  runtime  = "deno"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---
// Core collections
// ---

model Dish {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  name            String           @unique
  nameEmbedding   Float[]
  // Aliases to the dish name, useful to skip semantic search
  nameAliases     String[]         @default([])
  description     String
  recipes         Recipe[]
  media           Media[]
  searchMetadata  SearchMetadata
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  recipeInstances RecipeInstance[]
}

model Recipe {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  dishId           String          @db.ObjectId
  dish             Dish            @relation(fields: [dishId], references: [id])
  ingredients      IngredientRef[]
  tools            ToolRef[]
  steps            Step[]
  totalPrepSeconds Int
  media            Media[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model RecipeInstance {
  id               String              @id @default(auto()) @map("_id") @db.ObjectId
  dishId           String              @db.ObjectId
  dish             Dish                @relation(fields: [dishId], references: [id])
  ingredients      UserIngredientRef[]
  tools            ToolRef[]
  steps            UserStep[]
  totalPrepSeconds Int?
  sourceId         String              @db.ObjectId
  source           ProcessedUrl        @relation(fields: [sourceId], references: [id])
  index            Int
  modelConfidence  Float
  media            Media[]
  location         Location?
  language         String? // ISO 639
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

type IngredientRef {
  ingredientOrDishId String @db.ObjectId // TODO: relations in composite fields are not supported. Make sure this works well when querying the db
  quantity           Int
  unit               String
}

type UserIngredientRef {
  ingredientOrDishId String  @db.ObjectId // TODO: relations in composite fields are not supported. Make sure this works well when querying the db
  quantity           Int?
  unit               String?
}

model Ingredient {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String   @unique
  nameEmbedding Float[]
  // Aliases to the ingredient name, useful to skip semantic search
  nameAliases   String[] @default([])
  media         Media[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

type Step {
  description String
  ingredients IngredientRef[]
  tools       ToolRef[]
  prepSeconds Int
}

type UserStep {
  description String
  ingredients UserIngredientRef[]
  tools       ToolRef[]
  prepSeconds Int?
}

type ToolRef {
  tool         String   @db.ObjectId
  alternatives String[] @db.ObjectId
}

model Tool {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String   @unique
  nameEmbedding Float[]
  // Aliases to the tool name, useful to skip semantic search
  nameAliases   String[] @default([])
  media         Media[]
  createdAt     DateTime @default(now())
}

type Media {
  url         String
  type        MediaType
  description String?
  createdAt   DateTime  @default(now())
}

type Location {
  string    String
  geonameId String?
}

model ProcessedUrl {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  url             String           @unique
  recipeInstances RecipeInstance[]
  createdAt       DateTime         @default(now())
}

type SearchMetadata {
  youtube String?
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

// ---
// Utility collections
// ---

model ApiKey {
  id        String             @id @default(auto()) @map("_id") @db.ObjectId
  key       String             @unique
  name      String
  access    CollectionAccess[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

type CollectionAccess {
  collection String
  rules      AccessRule[]
}

enum AccessRule {
  CREATE
  READ
  UPDATE
  DELETE
  TASKS
}

model Task {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  status      TaskStatus @default(PENDING)
  stallCount  Int        @default(0)
  logs        LogEntry[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  completedAt DateTime?
}

enum TaskStatus {
  PENDING // The task has been added to the queue, but no worker is processing it, yet
  RUNNING // The task is being processed by a worker
  COMPLETED // The task was completed successfully
  FAILED // The task failed with an error
  STALLED // The task has been stalled due to a crash in the queue system
  CANCELED // The task was canceled
}

type LogEntry {
  timestamp DateTime
  type      LogType
  payload   String[]
}

enum LogType {
  I
  S
  W
  E
}
